{
  "name": "bra-b",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:frontend:web": "cd app/web && pnpm build",
    "build:backend": "cd app/backend && pnpm build",
    "lint": "turbo lint",
    "lint:biome": "biome check .",
    "format": "turbo format",
    "format:biome": "biome format . --write",
    "format:check": "biome format .",
    "check": "biome check --apply .",
    "test": "turbo test",
    "test:backend": "cd app/backend && pnpm test",
    "test:backend:coverage": "cd app/backend && pnpm test:coverage",
    "deploy": "turbo deploy",
    "deploy:frontend:web": "cd app/web && pnpm run deploy",
    "deploy:backend": "cd app/backend && pnpm run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.4.4"
  },
  "keywords": ["react", "hono", "cloudflare", "tanstack", "monorepo"],
  "author": "aiirononeko",
  "license": "ISC"
}
